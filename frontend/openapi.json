    "/actions": {
      "post": {
        "tags": [
          "actions"
        ],
        "summary": "Create Actions",
        "description": "POST /actions \u2014 create action rows for outbound sends (Fix 2, Fix 3).\n\nPrecondition checks (independent of graph state):\n  - analysis.status == 'approved'\n  - verdict is not BLOCK\n  - QUARANTINE must be confirmed (typed_reason provided)\n  - destination must be enabled (tool_config)\n  - breaker must not be open for the destination\n  - expected_analysis_version must match\n  - first send per (enquiry, destination) uses idempotency key enquiry_id:destination\n  - resend requires resend=true and resend_reason",
        "operationId": "create_actions_actions_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "title": "Body"
              }
            }
          }
