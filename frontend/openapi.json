    "/analyses/{analysis_id}/resume-review": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "Resume Review",
        "description": "Resume a paused analysis review (\u00a74.2, Fix 1, Fix 10).\n\nActions:\n  - approve: approve the analysis as-is\n  - edit_and_approve: apply edited_fields and approve\n  - reject: reject the analysis\n  - override_block: admin-only, override a BLOCK verdict\n\nValidates:\n  - expected_analysis_version matches current version\n  - override_block requires admin role\n  - typed_reason required for certain actions (reject, override_block, quarantine confirm)\n  - edited_fields required for edit_and_approve and override_block",
        "operationId": "resume_review_analyses__analysis_id__resume_review_post",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
