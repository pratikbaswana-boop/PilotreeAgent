# The Vite dev server proxies /api to http://127.0.0.1:8000.
VITE_API_URL=/api
VITE_OIDC_AUTHORITY=https://your-identity-provider.example
VITE_OIDC_CLIENT_ID=triage-spa
# Register http://localhost:5173/auth/callback (or the actual dev origin)
# and the production /auth/callback URL in your OIDC client.
# Include offline_access here if your provider supports refresh tokens for SPAs.
VITE_OIDC_SCOPE=openid profile email
# Development-only local sessions; also requires backend LOCAL_DEVELOPMENT_AUTH.
VITE_LOCAL_DEVELOPMENT_AUTH=false
