# ── Database ──────────────────────────────────────────────────────
# Transaction-mode pool (ordinary request-scoped queries via PgBouncer in prod)
DATABASE_URL=postgresql+asyncpg://triage:triage_dev@localhost:5432/triage
# Session-mode pool (LISTEN, advisory-lock holders, LangGraph checkpointer)
# In local dev without PgBouncer, point this at the same Postgres.
DATABASE_SESSION_POOL_URL=postgresql+asyncpg://triage:triage_dev@localhost:5432/triage
DATABASE_POOL_SIZE=20
DATABASE_SESSION_POOL_SIZE=3
LISTEN_RECONNECT_GRACE_SECONDS=15

# ── OIDC / JWT auth ───────────────────────────────────────────────
OIDC_ISSUER=https://your-oidc-provider.example.com
OIDC_CLIENT_ID=triage
OIDC_JWKS_URI=https://your-oidc-provider.example.com/.well-known/jwks.json
JWT_CLOCK_SKEW_SECONDS=30

# ── Job queue ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=8
JOB_SUCCEEDED_RETENTION_DAYS=7
ACTION_SENDING_TIMEOUT_SECONDS=30
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=500
JOB_BACKOFF_MAX_MS=60000

# ── HTTP timeouts ─────────────────────────────────────────────────
HTTP_CONNECT_TIMEOUT_MS=2000
HTTP_READ_TIMEOUT_MS=8000
LLM_READ_TIMEOUT_MS=20000
REQUEST_DEADLINE_BUDGET_MS=30000
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_MS=200

# ── Circuit breaker ───────────────────────────────────────────────
BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_SECONDS=60
BREAKER_COOLDOWN_SECONDS=30
BREAKER_COOLDOWN_MAX_SECONDS=300
BREAKER_CACHE_TTL_SECONDS=2

# ── Config cache / rate limits / bulkheads ────────────────────────
CONFIG_CACHE_TTL_SECONDS=10
RATE_LIMIT_GEMINI_RPS=5
RATE_LIMIT_SLACK_RPS=1
RATE_LIMIT_LINEAR_RPS=2
RATE_LIMIT_SHEETS_RPS=2
BULKHEAD_GEMINI_CONCURRENCY=10
BULKHEAD_SLACK_CONCURRENCY=5
BULKHEAD_LINEAR_CONCURRENCY=5
BULKHEAD_SHEETS_CONCURRENCY=3

# ── SSE ───────────────────────────────────────────────────────────
SSE_MAX_CONNECTION_SECONDS=600
SSE_RECONNECT_BACKOFF_BASE_MS=1000
SSE_RECONNECT_BACKOFF_MAX_MS=30000

# ── Claims / retention ────────────────────────────────────────────
CLAIM_TTL_SECONDS=300
EVENTS_RETENTION_DAYS=7
CHECKPOINT_RETENTION_DAYS=90

# ── Screeners / LLM ───────────────────────────────────────────────
PRESIDIO_THREAD_POOL_SIZE=4
PRESIDIO_SCORE_THRESHOLD=0.6
REGEX_SCAN_THREAD_POOL_SIZE=2
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash
PROMPT_VERSION=v1

# ── Gemini API key (production: load from secret manager) ─────────
GEMINI_API_KEY=

# Optional loopback-only development login (disabled by default).
LOCAL_DEVELOPMENT_AUTH=false
# Required only when enabling local login; generate at least 32 random characters.
LOCAL_DEVELOPMENT_SECRET=
